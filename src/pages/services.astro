---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'services');
if (!entry) throw new Error('Missing content: pages/services.md');
const { Content } = await render(entry);
---

<BaseLayout
  title="Services"
  description="Pathtaker offers mental health intensives including mini intensives, daylong healing, outdoor therapy, and multi-day backpacking therapy trips."
>
  <main class="max-w-4xl mx-auto px-6 py-12 md:py-16">
    <h1 class="text-4xl md:text-5xl text-brown-dark text-center mb-6">
      {entry.data.page_heading}
    </h1>

    <div class="mb-8">
      <img
        src="/images/IMG_4884.jpg"
        alt="Nature therapy setting"
        class="w-full h-auto object-cover rounded-xl"
        loading="eager"
      />
    </div>

    <p class="text-center text-lg leading-relaxed mb-10">
      {entry.data.tagline}
    </p>

    <blockquote class="border-l-4 border-brown/40 pl-6 italic text-lg leading-relaxed mb-12 text-brown">
      "{entry.data.quote}"
    </blockquote>

    <div class="prose prose-stone max-w-none
      prose-headings:font-heading prose-headings:font-normal prose-headings:text-brown-dark
      prose-h2:text-2xl prose-h3:text-xl prose-h3:font-bold
      prose-p:text-brown prose-p:leading-relaxed
      prose-li:text-brown prose-li:leading-relaxed
      prose-strong:text-brown">
      <Content />
    </div>
  </main>
</BaseLayout>
