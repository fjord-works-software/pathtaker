---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/url';

const entry = await getEntry('pages', 'services');
if (!entry) throw new Error('Missing content: pages/services.md');
const { page_heading, tagline, quote, services = [], approach_heading, approach_intro, modalities = [], cta } = entry.data;
---

<BaseLayout
  title="Services"
  description="Pathtaker offers mental health intensives including mini intensives, daylong healing, outdoor therapy, and multi-day backpacking therapy trips."
>
  <main class="w-full max-w-5xl mx-auto px-6 py-12 md:py-16">

    <div class="flex flex-col md:flex-row gap-10 mb-14 items-center">
      <div class="w-full md:w-1/2 overflow-hidden rounded-2xl shrink-0">
        <img
          src={url('/images/IMG_4884.jpg')}
          alt="Nature therapy setting"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>

      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h1 class="text-4xl md:text-5xl mb-4">{page_heading}</h1>
        <p class="text-lg leading-relaxed text-brown/70 mb-8">{tagline}</p>
        <blockquote class="border-l-4 border-brown/30 pl-6 italic text-lg leading-relaxed text-brown/80">
          "{quote}"
        </blockquote>
      </div>
    </div>

    {(approach_heading || modalities.length > 0) && (
      <div class="bg-brown/5 rounded-2xl px-8 py-8 mb-10">
        {approach_heading && <h2 class="text-2xl mb-2">{approach_heading}</h2>}
        {approach_intro && <p class="text-brown/70 tracking-body mb-5">{approach_intro}</p>}
        {modalities.length > 0 && (
          <ul class="flex flex-col gap-2">
            {modalities.map(m => (
              <li class="text-brown tracking-body">{m}</li>
            ))}
          </ul>
        )}
      </div>
    )}

    {services.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-14">
        {services.map(service => (
          <div class="flex flex-col gap-3 p-6 rounded-2xl border border-brown/15 hover:border-brown/30 hover:shadow-sm transition-all duration-200">
            {service.icon && <span class="text-3xl">{service.icon}</span>}
            <h2 class="text-xl">{service.name}</h2>
            <p class="text-brown/70 leading-relaxed tracking-body">{service.description}</p>
          </div>
        ))}
      </div>
    )}

    {cta && (
      <a href={url('/contact')} class="block text-center text-brown text-lg tracking-body hover:text-brown-dark transition-colors">{cta}</a>
    )}

  </main>
</BaseLayout>
