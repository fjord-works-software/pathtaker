---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Pathtaker. We'd love to hear from you and discuss how our mental health intensives can support your healing journey."
>
  <main class="w-full max-w-4xl mx-auto px-6 py-12 md:py-16">
    <h1 class="text-4xl md:text-5xl mb-10">Contact</h1>
    <ContactForm />
  </main>
</BaseLayout>
