---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageWithText from '../components/ImageWithText.astro';

const member = await getEntry('team', 'vice-president');
if (!member) throw new Error('Missing content: team/vice-president.md');
const { Content } = await render(member);
---

<BaseLayout
  title="Vice President"
  description={`Meet ${member.data.name} — Vice President of Pathtaker.`}
>
  <main>
    <ImageWithText src={member.data.photo} alt={member.data.name}>
      <h1 class="text-3xl md:text-4xl mb-3">{member.data.name}</h1>
      <p class="text-lg mb-4 text-brown/70">{member.data.title}</p>
      <div class="leading-relaxed space-y-4">
        <Content />
      </div>
    </ImageWithText>
  </main>
</BaseLayout>
