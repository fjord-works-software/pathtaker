---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('pages', 'donate');
if (!entry) throw new Error('Missing content: pages/donate.md');
const {
  donate_heading,
  donate_intro,
  donate_disclaimer,
  zeffy_display,
  campaigns,
  zeffy_form_url,
  donate_button_label,
} = entry.data;

// Zeffy share links look like https://www.zeffy.com/en-US/donation-form/<slug>;
// the embeddable version is the same path with /embed inserted and no locale.
const toEmbedUrl = (formUrl: string) =>
  formUrl
    .replace(/\/(?:[a-z]{2}-[A-Z]{2})(?=\/)/, '')
    .replace(/zeffy\.com\/(?!embed\/)/, 'zeffy.com/embed/');

// Prefer the campaigns list; fall back to the legacy single-campaign fields so
// an un-migrated donate.md still renders.
const list = (campaigns ?? []).filter((c) => c.zeffy_form_url);
if (!list.length && zeffy_form_url) {
  list.push({
    title: donate_heading ?? 'Donate',
    description: '',
    zeffy_form_url,
    button_label: donate_button_label,
  });
}

const showEmbed = zeffy_display === 'embed';
const showTabs = list.length > 1;
---

<BaseLayout
  title="Donate"
  description="Support Pathtaker's mission of providing mental health intensives to those who need deeper healing."
>
  <main
    class:list={[
      'w-full mx-auto px-6 py-12 md:py-20 text-center',
      // Embedded forms need room to breathe; keep the copy column narrow below.
      showEmbed ? 'max-w-4xl' : 'max-w-2xl',
    ]}
  >
    <div class="max-w-2xl mx-auto">
      <h1 class="text-4xl md:text-5xl mb-6">{donate_heading}</h1>

      <p class="text-lg leading-relaxed mb-4">{donate_intro}</p>

      <p class="leading-relaxed text-brown/70 mb-12">{donate_disclaimer}</p>
    </div>

    {list.length > 0 && (
      <div id="campaigns">
        {showTabs && (
          <>
            <p id="campaigns-label" class="text-sm uppercase tracking-widest text-brown/70 mb-3">
              Choose a campaign
            </p>
            {/* On phones the tabs split the row evenly and long titles wrap inside
                their tab. Sideways scrolling (with the script fading whichever edge
                has tabs hidden past it) only kicks in if there are too many to fit. */}
            <div data-tab-scroller class="tab-scroller overflow-x-auto p-1 scroll-px-8 mb-10">
              <div
                role="tablist"
                aria-labelledby="campaigns-label"
                class="flex min-w-min items-end justify-center gap-x-2 sm:gap-x-8 border-b border-brown/30"
              >
                {list.map((campaign, i) => (
                  <button
                    type="button"
                    role="tab"
                    id={`campaign-tab-${i}`}
                    aria-controls={`campaign-panel-${i}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    class:list={[
                      'font-heading flex-1 sm:flex-none sm:whitespace-nowrap text-balance cursor-pointer bg-transparent rounded-sm px-0.5 sm:px-1 pb-3 -mb-px text-sm sm:text-base leading-snug tracking-body border-b-3 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brown',
                      i === 0
                        ? 'border-brown text-brown'
                        : 'border-transparent text-brown/80 hover:text-brown',
                    ]}
                  >
                    {campaign.title}
                  </button>
                ))}
              </div>
            </div>
          </>
        )}

        {list.map((campaign, i) => (
          <div
            role="tabpanel"
            id={`campaign-panel-${i}`}
            aria-labelledby={showTabs ? `campaign-tab-${i}` : undefined}
            tabindex="0"
            hidden={i !== 0}
          >
            {showTabs && (
              <h2 class="text-2xl md:text-3xl mb-4">{campaign.title}</h2>
            )}

            {campaign.description && (
              <p class="leading-relaxed mb-8 max-w-2xl mx-auto">{campaign.description}</p>
            )}

            {showEmbed ? (
              <div
                class="relative w-full overflow-hidden rounded-2xl"
                style="height: clamp(480px, 125vw, 960px);"
              >
                <iframe
                  title={`Donation form for ${campaign.title}, powered by Zeffy`}
                  src={i === 0 ? toEmbedUrl(campaign.zeffy_form_url) : undefined}
                  data-src={toEmbedUrl(campaign.zeffy_form_url)}
                  class="absolute inset-0 w-full h-full border-0"
                  allowtransparency="true"
                ></iframe>
              </div>
            ) : (
              <a
                href={campaign.zeffy_form_url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-heading inline-block bg-brown text-cream px-10 py-4 rounded-pill text-base tracking-body hover:bg-brown-dark transition-colors"
              >
                {campaign.button_label || 'Donate'}
              </a>
            )}
          </div>
        ))}
      </div>
    )}
  </main>
</BaseLayout>

<script>
  const root = document.getElementById('campaigns');
  const tabs = Array.from(root?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? []);

  function select(index: number, focus = true) {
    tabs.forEach((tab, i) => {
      const active = i === index;
      const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');

      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      tab.classList.toggle('border-brown', active);
      tab.classList.toggle('text-brown', active);
      tab.classList.toggle('border-transparent', !active);
      tab.classList.toggle('text-brown/80', !active);
      tab.classList.toggle('hover:text-brown', !active);

      if (panel) panel.hidden = !active;
      if (active) tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });

      // Load each embed only once it is first shown, so switching back is instant.
      if (active) {
        const frame = panel?.querySelector('iframe');
        if (frame && !frame.getAttribute('src')) {
          frame.src = frame.dataset.src ?? '';
        }
      }
    });

    if (focus) tabs[index]?.focus();
  }

  const scroller = root?.querySelector<HTMLElement>('[data-tab-scroller]');

  function updateFades() {
    if (!scroller) return;
    const { scrollLeft, scrollWidth, clientWidth } = scroller;
    scroller.toggleAttribute('data-more-left', scrollLeft > 1);
    scroller.toggleAttribute('data-more-right', scrollLeft + clientWidth < scrollWidth - 1);
  }

  if (scroller) {
    scroller.addEventListener('scroll', updateFades, { passive: true });
    // Watch the tab row too: web fonts loading in can change whether it overflows.
    const observer = new ResizeObserver(updateFades);
    observer.observe(scroller);
    if (scroller.firstElementChild) observer.observe(scroller.firstElementChild);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(i, false));

    tab.addEventListener('keydown', (event) => {
      const keys: Record<string, number> = {
        ArrowRight: (i + 1) % tabs.length,
        ArrowLeft: (i - 1 + tabs.length) % tabs.length,
        Home: 0,
        End: tabs.length - 1,
      };

      if (event.key in keys) {
        event.preventDefault();
        select(keys[event.key]);
      }
    });
  });
</script>

<style>
  .tab-scroller {
    --fade-left: 0px;
    --fade-right: 0px;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--fade-left),
      #000 calc(100% - var(--fade-right)),
      transparent
    );
    scrollbar-width: none;
  }

  .tab-scroller::-webkit-scrollbar {
    display: none;
  }

  .tab-scroller[data-more-left] {
    --fade-left: 2.5rem;
  }

  .tab-scroller[data-more-right] {
    --fade-right: 2.5rem;
  }
</style>
