---
interface Props {
  src: string;
  alt?: string;
  height?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt = '', height = '600px', loading = 'lazy' } = Astro.props;
---

<div class="w-full flex justify-center overflow-hidden">
  <img
    src={src}
    alt={alt}
    loading={loading}
    style={`max-height: ${height};`}
    class="max-w-full h-auto block"
  />
</div>
