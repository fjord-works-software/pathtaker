---
interface Props {
  accessKey?: string;
  subject?: string;
  nameLabel?: string;
  namePlaceholder?: string;
  emailLabel?: string;
  emailPlaceholder?: string;
  phoneLabel?: string;
  phonePlaceholder?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
  submitLabel?: string;
}

const {
  accessKey = '',
  subject = 'New message from Pathtaker.org',
  nameLabel = 'Name',
  namePlaceholder = 'Your name',
  emailLabel = 'Email',
  emailPlaceholder = 'your@email.com',
  phoneLabel = 'Phone number',
  phonePlaceholder = '(optional)',
  messageLabel = 'Message',
  messagePlaceholder = 'How can we help you?',
  submitLabel = 'Send Message',
} = Astro.props;

const inputClass = 'border border-brown/30 rounded px-4 py-2.5 bg-transparent text-brown placeholder-brown/40 focus:outline-none focus:border-brown transition-colors';
---

<form
  id="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="flex flex-col gap-5"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={subject} />
  <input type="text" name="botcheck" class="hidden" style="display:none" />

  <div class="flex flex-col md:flex-row gap-5">
    <div class="flex flex-col gap-1 flex-1">
      <label for="cf-name" class="text-sm text-brown tracking-body">{nameLabel}</label>
      <input type="text" id="cf-name" name="name" required class={inputClass} placeholder={namePlaceholder} />
    </div>

    <div class="flex flex-col gap-1 flex-1">
      <label for="cf-email" class="text-sm text-brown tracking-body">{emailLabel}</label>
      <input type="email" id="cf-email" name="email" required class={inputClass} placeholder={emailPlaceholder} />
    </div>
  </div>

  <div class="flex flex-col gap-1">
    <label for="cf-phone" class="text-sm text-brown tracking-body">{phoneLabel}</label>
    <input type="tel" id="cf-phone" name="phone" class={inputClass} placeholder={phonePlaceholder} />
  </div>

  <div class="flex flex-col gap-1">
    <label for="cf-message" class="text-sm text-brown tracking-body">{messageLabel}</label>
    <textarea id="cf-message" name="message" rows="5" required class={`${inputClass} resize-none`} placeholder={messagePlaceholder}></textarea>
  </div>

  <div id="cf-result" class="hidden text-sm text-brown tracking-body" aria-live="polite"></div>

  <button
    type="submit"
    data-label={submitLabel}
    class="self-start bg-brown text-cream px-8 py-3 rounded-pill text-sm tracking-body hover:bg-brown-dark transition-colors cursor-pointer"
  >
    {submitLabel}
  </button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const result = document.getElementById('cf-result');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalLabel = btn.dataset.label || 'Send Message';
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const data = new FormData(form);
    const response = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      body: data,
    });
    const json = await response.json();

    if (result) {
      result.classList.remove('hidden');
      if (json.success) {
        result.textContent = 'Thank you! Your message has been sent.';
        form.reset();
      } else {
        result.textContent = 'Something went wrong. Please try again or email us directly.';
      }
    }

    btn.disabled = false;
    btn.textContent = originalLabel;
  });
</script>
