---
// Web3Forms access key — set in Phase 4
const accessKey = '';
---

<form
  id="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="max-w-2xl mx-auto flex flex-col gap-5"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New message from Pathtaker.org" />
  <input type="text" name="botcheck" class="hidden" style="display:none" />

  <div class="flex flex-col gap-1">
    <label for="cf-name" class="text-sm text-brown tracking-body">Name</label>
    <input
      type="text"
      id="cf-name"
      name="name"
      required
      class="border border-brown/30 rounded px-4 py-2.5 bg-transparent text-brown placeholder-brown/40 focus:outline-none focus:border-brown transition-colors"
      placeholder="Your name"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="cf-email" class="text-sm text-brown tracking-body">Email</label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      class="border border-brown/30 rounded px-4 py-2.5 bg-transparent text-brown placeholder-brown/40 focus:outline-none focus:border-brown transition-colors"
      placeholder="your@email.com"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="cf-phone" class="text-sm text-brown tracking-body">Phone number</label>
    <input
      type="tel"
      id="cf-phone"
      name="phone"
      class="border border-brown/30 rounded px-4 py-2.5 bg-transparent text-brown placeholder-brown/40 focus:outline-none focus:border-brown transition-colors"
      placeholder="(optional)"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="cf-message" class="text-sm text-brown tracking-body">Message</label>
    <textarea
      id="cf-message"
      name="message"
      rows="5"
      required
      class="border border-brown/30 rounded px-4 py-2.5 bg-transparent text-brown placeholder-brown/40 focus:outline-none focus:border-brown transition-colors resize-none"
      placeholder="How can we help you?"
    ></textarea>
  </div>

  <div id="cf-result" class="hidden text-sm text-brown tracking-body" aria-live="polite"></div>

  <button
    type="submit"
    class="self-start bg-brown text-cream px-8 py-3 rounded-pill text-sm tracking-body hover:bg-brown-dark transition-colors cursor-pointer"
  >
    Send Message
  </button>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const result = document.getElementById('cf-result');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    const data = new FormData(form);
    const response = await fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      body: data,
    });
    const json = await response.json();

    if (result) {
      result.classList.remove('hidden');
      if (json.success) {
        result.textContent = 'Thank you! Your message has been sent.';
        form.reset();
      } else {
        result.textContent = 'Something went wrong. Please try again or email us directly.';
      }
    }

    btn.disabled = false;
    btn.textContent = 'Send Message';
  });
</script>
